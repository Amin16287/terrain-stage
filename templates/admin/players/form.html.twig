{% extends 'admin/base.html.twig' %}

{% block title %}{{ isNew ? 'Nouveau joueur' : 'Modifier le joueur' }} | Terrain Admin{% endblock %}
{% block topbar_title %}{{ isNew ? '➕ Nouveau joueur' : '✏️ Modifier le joueur' }}{% endblock %}

{% block topbar_actions %}
    <a href="{{ path('app_admin_teams_index') }}" class="btn sm secondary">← Retour équipes</a>
{% endblock %}

{% block body %}
<div class="page-title">
    <h1>{{ isNew ? 'Créer un nouveau joueur' : 'Modifier le joueur' }}</h1>
    <p>Renseignez les informations du joueur (nom, poste, licence, etc.)</p>
</div>

<div class="card">
    <div class="card-header">
        <h3>Informations du joueur</h3>
    </div>
    <div class="card-body">
        <form method="post" action="{{ isNew ? path('app_admin_players_new') : path('app_admin_players_edit', { id: player.id }) }}" class="form-grid">
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Nom <span class="required">*</span></label>
                    <input type="text" class="form-input" name="lastName" required
                        value="{{ player ? player.lastName : '' }}"
                        placeholder="Ex : DUPONT">
                </div>
                <div class="form-group">
                    <label class="form-label">Prénom <span class="required">*</span></label>
                    <input type="text" class="form-input" name="firstName" required
                        value="{{ player ? player.firstName : '' }}"
                        placeholder="Ex : Jean">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Poste <span class="required">*</span></label>
                    <select class="form-select" name="position" required>
                        <option value="">-- Sélectionner un poste --</option>
                        {% set positions = ['Gardien', 'Défenseur', 'Défenseur central', 'Défenseur latéral', 'Milieu', 'Milieu relayeur', 'Milieu offensif', 'Milieu défensif', 'Ailier gauche', 'Ailier droit', 'Attaquant', 'Avant-centre'] %}
                        {% for pos in positions %}
                            <option value="{{ pos }}" {{ player and player.position == pos ? 'selected' }}>{{ pos }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Équipe <span class="required">*</span></label>
                    <select class="form-select" name="team" required>
                        <option value="">-- Sélectionner une équipe --</option>
                        {% for t in teams %}
                            <option value="{{ t.id }}"
                                {{ player and player.team and player.team.id == t.id ? 'selected' }}>
                                {{ t.name }}{% if t.category %} ({{ t.category }}){% endif %}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Numéro de licence</label>
                    <input type="text" class="form-input" name="licenseNumber"
                        value="{{ player ? (player.licenseNumber ?? '') : '' }}"
                        placeholder="Ex : FRA-000099">
                </div>
                <div class="form-group">
                    <label class="form-label">Date de naissance</label>
                    <input type="date" class="form-input" name="birthDate"
                        value="{{ player and player.birthDate ? player.birthDate|date('Y-m-d') : '' }}">
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn primary lg">
                    <span>💾</span> {{ isNew ? 'Créer le joueur' : 'Enregistrer' }}
                </button>
                <a href="{{ player and player.team ? path('app_admin_teams_show', { id: player.team.id }) : path('app_admin_teams_index') }}" class="btn secondary lg">
                    Annuler
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
