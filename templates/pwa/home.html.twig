{% extends 'base.html.twig' %}

{% block title %}Terrain | Accueil{% endblock %}

{% block body %}
<style>
  :root {
    --bg: #eef2f0;
    --panel: #ffffff;
    --text: #0b1f12;
    --muted: #475569;
    --line: #dbe4dd;
    --accent: #16a34a;
    --accent-dark: #166534;
    --shadow-sm: 0 1px 2px rgba(11,31,18,.08), 0 1px 1px rgba(11,31,18,.04);
    --shadow-md: 0 10px 25px rgba(11,31,18,.12), 0 4px 10px rgba(11,31,18,.06);
    --shadow-lg: 0 30px 60px rgba(11,31,18,.18), 0 15px 30px rgba(11,31,18,.08);
    --radius-lg: 24px;
    font-family: ui-rounded, -apple-system, BlinkMacSystemFont, "SF Pro Rounded",
                 "Segoe UI", system-ui, "Inter", sans-serif;
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background:
      radial-gradient(1200px 600px at 10% -10%, rgba(22,163,74,.14), transparent 60%),
      radial-gradient(1000px 500px at 110% 20%, rgba(14,165,233,.10), transparent 55%),
      #e8efe9;
    color: var(--text);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }
  .home-wrap {
    max-width: 480px;
    margin: 0 auto;
    padding: 32px 20px 48px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .home-hero {
    background: linear-gradient(180deg, #0c4a2a, #0b3d20);
    color: #f8fafc;
    border-radius: 28px;
    padding: 28px 22px;
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
  }
  .home-hero::before {
    content: "";
    position: absolute;
    top: -80px; right: -80px;
    width: 260px; height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(34,197,94,.35), transparent 60%);
  }
  .home-hero::after {
    content: "";
    position: absolute;
    bottom: -60px; left: -40px;
    width: 220px; height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(14,165,233,.18), transparent 60%);
  }
  .hero-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    position: relative;
  }
  .hero-logo {
    width: 52px; height: 52px;
    border-radius: 16px;
    background: linear-gradient(135deg, #22c55e, var(--accent));
    color: #fff;
    display: grid;
    place-items: center;
    font-weight: 900;
    font-size: 24px;
    box-shadow: var(--shadow-md);
  }
  .hero-title {
    font-weight: 900;
    letter-spacing: -0.02em;
    font-size: 22px;
    line-height: 1.1;
  }
  .hero-sub {
    font-size: 12px;
    opacity: .75;
    font-weight: 700;
    margin-top: 2px;
  }
  .hero-headline {
    font-weight: 900;
    font-size: 26px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 18px 0 6px;
    position: relative;
  }
  .hero-desc {
    font-size: 14px;
    font-weight: 600;
    opacity: .82;
    line-height: 1.5;
    margin-bottom: 22px;
    position: relative;
  }
  .hero-cta {
    position: relative;
    display: block;
    width: 100%;
    min-height: 60px;
    border-radius: 18px;
    border: 0;
    background: linear-gradient(180deg, #4ade80, #22c55e);
    color: #052e16;
    font-family: inherit;
    font-weight: 900;
    font-size: 16px;
    letter-spacing: -0.01em;
    cursor: pointer;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 0 16px 36px rgba(34,197,94,.35), inset 0 1px 0 rgba(255,255,255,.4);
    transition: transform .08s ease;
  }
  .hero-cta:active { transform: scale(.985); }
  .hero-cta-icon {
    width: 28px; height: 28px;
    border-radius: 999px;
    background: rgba(5,46,22,.18);
    display: grid;
    place-items: center;
    font-size: 14px;
  }

  .stats-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .stat-card {
    background: #fff;
    border-radius: 20px;
    border: 1px solid var(--line);
    padding: 16px;
    box-shadow: var(--shadow-sm);
  }
  .stat-label {
    font-size: 11px;
    color: var(--muted);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-bottom: 6px;
  }
  .stat-value {
    font-weight: 900;
    font-size: 26px;
    letter-spacing: -0.02em;
    color: var(--accent-dark);
    font-variant-numeric: tabular-nums;
  }

  .home-card {
    background: #fff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    padding: 18px 18px 20px;
    box-shadow: var(--shadow-sm);
  }
  .home-card h3 {
    margin: 0 0 10px;
    font-size: 16px;
    font-weight: 900;
    letter-spacing: -0.01em;
    color: #0b3d20;
  }
  .feature-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .feature-item {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 10px;
    align-items: start;
    padding: 4px 0;
  }
  .feature-icon {
    width: 34px; height: 34px;
    border-radius: 12px;
    background: rgba(22,163,74,.12);
    color: var(--accent-dark);
    display: grid;
    place-items: center;
    font-size: 16px;
  }
  .feature-title {
    font-weight: 800;
    font-size: 13px;
    color: var(--text);
    line-height: 1.1;
  }
  .feature-desc {
    font-size: 12px;
    color: var(--muted);
    font-weight: 600;
    margin-top: 2px;
    line-height: 1.4;
  }

  .legend-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 4px 2px 0;
  }
  .legend-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(22,163,74,.10);
    color: var(--accent-dark);
    font-weight: 800;
    font-size: 11px;
    white-space: nowrap;
  }

  .status-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0 0;
    margin-top: 8px;
    border-top: 1px solid var(--line);
  }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    font-weight: 800;
    font-size: 11px;
    color: var(--text);
  }
  .status-pill::before {
    content: "";
    width: 8px; height: 8px; border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(22,163,74,.18);
  }
  .install-hint {
    font-size: 11px;
    color: var(--muted);
    font-weight: 700;
    text-align: right;
    max-width: 60%;
  }
</style>

<div class="home-wrap">

  <div class="home-hero">
    <div class="hero-brand">
      <div class="hero-logo">T</div>
      <div>
        <div class="hero-title">Terrain</div>
        <div class="hero-sub">Saisie stats · PWA offline</div>
      </div>
    </div>

    <div class="hero-headline">Saisir les stats de match, terrain, en temps réel.</div>
    <div class="hero-desc">Application mobile-first, pensée pour les bords de terrain : gros boutons, fort contraste, fonctionnement hors-ligne.</div>

    <a href="{{ path('app_match_selection') }}" class="hero-cta">
      <span class="hero-cta-icon">▶</span>
      Accéder à la liste des matchs
    </a>
  </div>

  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-label">Matchs enregistrés</div>
      <div class="stat-value">{{ totalMatches }}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Mode de saisie</div>
      <div class="stat-value" style="font-size:16px; padding-top:4px;">Temps réel</div>
    </div>
  </div>

  <div class="home-card">
    <h3>Fonctionnalités</h3>
    <ul class="feature-list">
      <li class="feature-item">
        <div class="feature-icon">⚽</div>
        <div>
          <div class="feature-title">6 types d'événements</div>
          <div class="feature-desc">Tir, but, passe clé, cartons, remplacement.</div>
        </div>
      </li>
      <li class="feature-item">
        <div class="feature-icon">🎯</div>
        <div>
          <div class="feature-title">Cibles tactiles ≥ 44px</div>
          <div class="feature-desc">Boutons adaptés à une utilisation à une main, même sous le soleil.</div>
        </div>
      </li>
      <li class="feature-item">
        <div class="feature-icon">🔄</div>
        <div>
          <div class="feature-title">Annulation rapide</div>
          <div class="feature-desc">Chaque événement peut être annulé en un tap.</div>
        </div>
      </li>
      <li class="feature-item">
        <div class="feature-icon">🌐</div>
        <div>
          <div class="feature-title">Hors-ligne compatible</div>
          <div class="feature-desc">PWA avec service worker et synchronisation différée.</div>
        </div>
      </li>
    </ul>
  </div>

  <div class="legend-row">
    <span class="legend-chip">🎯 Mobile-first</span>
    <span class="legend-chip">☀️ Contraste fort</span>
    <span class="legend-chip">♿ WCAG AA+</span>
    <span class="legend-chip" data-controller="connectivity" data-connectivity-target="badge">
      <span data-connectivity-target="label">En ligne</span>
    </span>
  </div>

  <div class="status-row">
    <button
      type="button"
      class="status-pill"
      data-install-prompt-target="button"
      data-action="install-prompt#prompt"
      hidden
      style="flex:1; min-height:44px; border-radius:1rem; background:var(--accent); color:#fff; border:0; font-weight:800; font-size:.9rem; cursor:pointer;"
    >
      Installer Terrain
    </button>
    <span
      data-install-prompt-target="hint"
      class="install-hint"
    >
      Ajoutez l'app sur votre écran d'accueil via le menu du navigateur.
    </span>
  </div>
</div>
{% endblock %}
