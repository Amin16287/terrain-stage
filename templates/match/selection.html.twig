{% extends 'base.html.twig' %}

{% block title %}Terrain | Sélection du match{% endblock %}

{% block body %}
<style>
  :root {
    --bg: #eef2f0;
    --panel: #ffffff;
    --text: #0b1f12;
    --muted: #475569;
    --line: #dbe4dd;
    --accent: #16a34a;
    --accent-dark: #166534;
    --pitch: #166534;
    --grass: #15803d;
    --scoreboard: #0b3d20;
    --scoreboard-text: #f8fafc;
    --live: #ef4444;
    --scheduled: #64748b;
    --finished: #16a34a;
    --warning: #f59e0b;
    --danger: #dc2626;
    --shadow-sm: 0 1px 2px rgba(11,31,18,.08), 0 1px 1px rgba(11,31,18,.04);
    --shadow-md: 0 10px 25px rgba(11,31,18,.12), 0 4px 10px rgba(11,31,18,.06);
    --shadow-lg: 0 30px 60px rgba(11,31,18,.18), 0 15px 30px rgba(11,31,18,.08);
    --radius-lg: 24px;
    --radius-md: 18px;
    --radius-sm: 12px;
    font-family: ui-rounded, -apple-system, BlinkMacSystemFont, "SF Pro Rounded",
                 "Segoe UI", system-ui, "Inter", sans-serif;
    color-scheme: light;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background:
      radial-gradient(1200px 600px at 10% -10%, rgba(22,163,74,.14), transparent 60%),
      radial-gradient(1000px 500px at 110% 20%, rgba(14,165,233,.10), transparent 55%),
      #e8efe9;
    color: var(--text);
    min-height: 100vh;
    padding-bottom: 40px;
    -webkit-font-smoothing: antialiased;
  }

  .app-wrapper {
    max-width: 480px;
    margin: 0 auto;
    min-height: 100vh;
    background: var(--bg);
    position: relative;
  }

  .statusbar {
    position: sticky;
    top: 0;
    z-index: 20;
    height: 48px;
    padding: 0 28px 0 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    font-weight: 700;
    background: var(--bg);
    color: var(--text);
  }

  .app-content {
    padding: 0 16px 32px;
    overflow-y: auto;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 4px 14px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand-mark {
    width: 38px; height: 38px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--accent), #22c55e);
    color: #fff;
    display: grid;
    place-items: center;
    font-weight: 900;
    font-size: 18px;
    box-shadow: var(--shadow-md);
  }
  .brand-title {
    font-weight: 900;
    letter-spacing: -0.02em;
    font-size: 18px;
    line-height: 1;
  }
  .brand-sub { font-size: 11px; color: var(--muted); font-weight: 700; margin-top: 3px; }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    font-weight: 800;
    font-size: 12px;
    color: var(--text);
  }
  .status-pill::before {
    content: "";
    width: 8px; height: 8px; border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(22,163,74,.18);
  }
  .status-pill.offline::before { background: var(--danger); box-shadow: 0 0 0 3px rgba(220,38,38,.15); }

  .section-title {
    margin: 6px 2px 12px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }
  .section-title h2 {
    margin: 0;
    font-size: 22px;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: #0b3d20;
  }
  .section-title .count {
    font-size: 12px;
    color: var(--muted);
    font-weight: 700;
  }
  .tabs {
    display: inline-flex;
    padding: 4px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    margin-bottom: 16px;
    box-shadow: var(--shadow-sm);
    width: 100%;
    box-sizing: border-box;
  }
  .tab {
    flex: 1;
    text-align: center;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 800;
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
  }
  .tab.active {
    background: var(--accent);
    color: #fff;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.3);
  }

  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  .match-list { display: grid; gap: 14px; }

  .match-card {
    position: relative;
    background: #fff;
    border-radius: var(--radius-lg);
    padding: 16px 16px 18px;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: transform .12s ease;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .match-card:active { transform: scale(.985); }

  .match-card.live::before {
    content: "";
    position: absolute;
    top: 0; bottom: 0; left: 0;
    width: 5px;
    background: linear-gradient(180deg, var(--live), #b91c1c);
    box-shadow: 8px 0 24px rgba(239,68,68,.18);
  }
  .match-card.live { box-shadow: var(--shadow-md), 0 0 0 1px rgba(239,68,68,.18); }

  .match-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.02em;
  }
  .status-badge.live {
    background: rgba(239,68,68,.12);
    color: var(--live);
  }
  .status-badge.live::before {
    content: "";
    width: 7px; height: 7px; border-radius: 999px;
    background: var(--live);
    animation: pulse 1.4s infinite;
  }
  .status-badge.scheduled {
    background: rgba(100,116,139,.12);
    color: var(--scheduled);
  }
  .status-badge.finished {
    background: rgba(22,163,74,.12);
    color: var(--finished);
  }
  .match-meta {
    font-size: 12px;
    color: var(--muted);
    font-weight: 700;
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }
  .dot { opacity: .4; }

  .teams {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .team {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .team.home { text-align: left; }
  .team.away { text-align: right; }
  .team-name {
    font-size: 15px;
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .team-tag {
    font-size: 10px;
    font-weight: 800;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .team.away .team-tag { color: rgba(168,85,247,.85); }
  .score {
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    font-size: 20px;
    padding: 6px 10px;
    border-radius: 12px;
    background: rgba(22,101,52,.06);
    color: var(--accent-dark);
  }
  .score .dash { color: var(--muted); font-weight: 700; }
  .score.scheduled {
    background: transparent;
    color: var(--muted);
    font-size: 14px;
    padding: 0;
  }

  .cta-btn {
    width: 100%;
    min-height: 54px;
    border-radius: 16px;
    border: 0;
    font-family: inherit;
    font-weight: 900;
    font-size: 15px;
    letter-spacing: -0.01em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: transform .08s ease;
    text-decoration: none;
  }
  .cta-btn:active { transform: scale(.98); }
  .cta-btn.primary {
    background: linear-gradient(180deg, #22c55e, var(--accent));
    color: #fff;
    box-shadow: 0 10px 20px rgba(22,163,74,.30), inset 0 1px 0 rgba(255,255,255,.28);
  }
  .cta-btn.secondary {
    background: #fff;
    color: var(--text);
    border: 1.5px solid var(--line);
    box-shadow: var(--shadow-sm);
  }
  .cta-icon {
    display: inline-grid;
    place-items: center;
    width: 22px; height: 22px;
    border-radius: 999px;
    background: rgba(255,255,255,.22);
    font-size: 12px;
  }
  .cta-btn.secondary .cta-icon {
    background: rgba(22,163,74,.10);
    color: var(--accent-dark);
  }

  .empty-card {
    background: #fff;
    border: 1px dashed var(--line);
    border-radius: var(--radius-lg);
    padding: 22px;
    text-align: center;
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: .55; transform: scale(1.25); }
  }

  .go-home-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 12px;
    background: #fff;
    border: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
    font-weight: 800;
    font-size: 12px;
    margin-bottom: 12px;
  }
</style>

<div class="app-wrapper">
  <div class="statusbar"><span>9:41</span><span>5G 🔋</span></div>

  <div class="app-content">
    <a href="{{ path('app_home') }}" class="go-home-btn">← Retour accueil</a>

    <div class="topbar">
      <div class="brand">
        <div class="brand-mark" aria-hidden="true">T</div>
        <div>
          <div class="brand-title">Terrain</div>
          <div class="brand-sub">Sélection du match</div>
        </div>
      </div>
      <div class="status-pill" data-controller="connectivity" data-connectivity-target="badge">
        <span data-connectivity-target="label">En ligne</span>
      </div>
    </div>

    <div class="section-title">
      <h2>Matchs</h2>
    </div>

    <div class="tabs" role="tablist">
      <span class="tab active" role="tab" data-tab="today">Aujourd'hui</span>
      <span class="tab" role="tab" data-tab="week">Semaine</span>
      <span class="tab" role="tab" data-tab="finished">Terminés</span>
    </div>

    <div class="tab-panel active" data-panel="today">
      <div class="section-title">
        <h2 style="font-size:16px;">Matchs du jour</h2>
        <span class="count">{{ todayMatches|length }} prévu(s)</span>
      </div>
      <div class="match-list">
        {% for match in todayMatches %}
          {% include 'match/_match_card.html.twig' with { match: match } %}
        {% else %}
          <div class="empty-card">💡 Aucun match pour aujourd'hui</div>
        {% endfor %}
      </div>
    </div>

    <div class="tab-panel" data-panel="week">
      <div class="section-title">
        <h2 style="font-size:16px;">Cette semaine</h2>
        <span class="count">{{ weekMatches|length }} match(s)</span>
      </div>
      <div class="match-list">
        {% for match in weekMatches %}
          {% include 'match/_match_card.html.twig' with { match: match } %}
        {% else %}
          <div class="empty-card">💡 Aucun match prévu cette semaine</div>
        {% endfor %}
      </div>
    </div>

    <div class="tab-panel" data-panel="finished">
      <div class="section-title">
        <h2 style="font-size:16px;">Matchs terminés</h2>
        <span class="count">{{ finishedMatches|length }} dernier(s)</span>
      </div>
      <div class="match-list">
        {% for match in finishedMatches %}
          {% include 'match/_match_card.html.twig' with { match: match } %}
        {% else %}
          <div class="empty-card">💡 Aucun match terminé</div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.tab[data-tab]').forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab;
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      document.querySelector(`.tab-panel[data-panel="${target}"]`).classList.add('active');
    });
  });
</script>
{% endblock %}
